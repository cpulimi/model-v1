# Data generation (kept local only -- pulling these onto SOL breaks `git pull`
# when the node already has its own untracked copies). The generated datasets
# themselves ARE tracked, as instances_*hubs/ and instances_low|medium|high/.
# scripts/git-sync-once.sh runs `git add -A`, so without these rules the auto
# sync watcher would put them straight back.
data_generation_V7.ipynb
default_anchor_cities.csv
latam_anchor_cities.csv

# Run artifacts (large; regenerate from scripts)
outputs/
outputs.zip
sbatch_scripts/logs/
sbatch_scripts/results/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
.claude/
.cursor/
cursor_prompt.md

# Auto-sync runtime (scripts/ are tracked)
.auto-sync.pid
.auto-sync.lock
.auto-sync.log

# Secrets
.env
*.pem
gurobi.lic
